#!/usr/bin/env bash
# 本地 pre-push 钩子：推送前校验 workflow YAML 和 README 资源。
#
# 为什么必须要这个（2026-11-23 的事故）：
#   run: bash xxx.sh "chore: daily update"
#                                   ^ 冒号+空格 让 YAML 当成新映射键
#   -> GitHub 解析失败，name 回退成文件路径，workflow_dispatch 消失，
#      dispatch API 返回 422，push 建的 run 里 total_count=0（无 job）。
#   CI 里的自检对这个文件自己是循环依赖——YAML 坏了 workflow 根本起不来，
#   所以只能在推送**之前**本地拦下。
#
# 安装：bash scripts/install_hooks.sh
set -uo pipefail

# 钩子执行时 cwd 不一定是仓库根目录，先切过去（否则找不到 verify_*.py）
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -n "${REPO_ROOT:-}" ]; then
  cd "$REPO_ROOT" || exit 1
fi

# 选一个「能跑、且装了 PyYAML」的 python。
# 不能只看 command -v：PortableGit 里 python3 可能是坏 shim，
# Windows 的 py 启动器可能指向没装依赖的解释器。
find_python() {
  local cands=()
  # 1) 环境变量显式指定
  [ -n "${DSH_PYTHON:-}" ] && cands+=("$DSH_PYTHON")
  # 2) PATH 里的常规命令
  cands+=(python3 python py)
  # 3) Windows 常见安装位置（PortableGit bash 里 PATH 常常不全）
  #    注意 set -u 下不能直接用 $USER，用 HOME 派生
  local home="${HOME:-}"
  if [ -n "$home" ]; then
    for v in 39 313 315 314; do
      cands+=("$home/AppData/Local/Programs/Python/Python$v/python.exe")
    done
  fi
  # 4) 兜底：扫一遍 Python* 目录
  if [ -d "$home/AppData/Local/Programs/Python" ]; then
    for d in "$home"/AppData/Local/Programs/Python/Python*/python.exe; do
      [ -x "$d" ] && cands+=("$d")
    done
  fi

  for c in "${cands[@]}"; do
    [ -n "$c" ] || continue
    if command -v "$c" >/dev/null 2>&1 || [ -x "$c" ]; then
      if "$c" -c "import yaml" >/dev/null 2>&1; then
        echo "$c"
        return 0
      fi
    fi
  done
  return 1
}

PY="$(find_python)" || PY=""
if [ -z "$PY" ]; then
  echo "[pre-push] 找不到装了 PyYAML 的 python，跳过校验"
  echo "           手动安装：pip install pyyaml"
  exit 0
fi

echo "[pre-push] 校验 workflow YAML... ($PY)"
if ! "$PY" verify_workflows.py; then
  echo ""
  echo "[pre-push] workflow YAML 有问题，已阻止推送。"
  echo "           修好后重新 push，或用 git push --no-verify 强制跳过。"
  exit 1
fi

if [ -f verify_readme.py ]; then
  echo "[pre-push] 校验 README 资源..."
  if ! "$PY" verify_readme.py; then
    echo ""
    echo "[pre-push] README 资源不一致，已阻止推送。"
    echo "           先跑 python main.py 重新生成产物。"
    exit 1
  fi
fi

echo "[pre-push] 全部通过"
exit 0