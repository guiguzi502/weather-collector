# 默认按内容自动判断，文本文件统一 LF
* text=auto eol=lf

# shell 脚本必须是 LF，否则 Linux CI 上 bash 会报 bad interpreter
*.sh            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.py            text eol=lf

# 二进制文件绝不做换行转换（否则 SQLite / PNG 会被损坏）
*.db            binary
*.png           binary
*.jpg           binary
*.ico           binary
*.zip           binary
